# Copie para .env e preencha. Nunca publique o .env.
PORT=4330
PUBLIC_URL=http://localhost:4330

# Painel do artista (gere com: node tools/set-password.mjs "sua-senha")
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Google Agenda (Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth, tipo "Aplicativo da Web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4330/oauth/google/callback
GOOGLE_CALENDAR_ID=primary

# Pasta dos dados (pedidos, referências enviadas, catálogo). Padrão: ./data
# DATA_DIR=
